<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agenda.MainController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <MenuBar>
                    <menus>
                        <Menu mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Salir" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Ayuda">
                            <items>
                                <MenuItem mnemonicParsing="false" text="Acerca de" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <ToolBar>
                    <items>
                        <Button fx:id="btnNuevo" mnemonicParsing="false" text="Nuevo" />
                        <Separator orientation="VERTICAL" />
                        <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" text="Actualizar" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" text="Eliminar" />
                        <Separator orientation="VERTICAL" />
                        <Label text="Buscar:" />
                        <TextField fx:id="txtBuscar" prefWidth="150.0" promptText="Buscar por nombre..." />
                        <Button fx:id="btnBuscar" mnemonicParsing="false" text="Buscar" />
                        <Button fx:id="btnMostrarTodos" mnemonicParsing="false" text="Mostrar Todos" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.6" BorderPane.alignment="CENTER">
            <items>
                <VBox>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Lista de Personas">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <TableView fx:id="tablaPersonas" prefHeight="400.0" prefWidth="400.0">
                            <columns>
                                <TableColumn fx:id="columnaNombre" prefWidth="120.0" text="Nombre" />
                                <TableColumn fx:id="columnaDireccion" prefWidth="150.0" text="Dirección" />
                                <TableColumn fx:id="columnaTelefonos" prefWidth="130.0" text="Teléfonos" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
                <VBox>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Detalles de Persona">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                            </rowConstraints>
                            <children>
                                <Label text="Nombre:" />
                                <TextField fx:id="txtNombre" prefWidth="200.0" GridPane.columnIndex="1" />
                                <Label text="Dirección:" GridPane.rowIndex="1" />
                                <TextField fx:id="txtDireccion" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                        <Separator>
                            <VBox.margin>
                                <Insets bottom="10.0" top="15.0" />
                            </VBox.margin>
                        </Separator>
                        <Label style="-fx-font-weight: bold;" text="Teléfonos">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtTelefono" prefWidth="150.0" promptText="Nuevo teléfono..." />
                                <Button fx:id="btnAgregarTelefono" mnemonicParsing="false" text="Agregar" />
                                <Button fx:id="btnEliminarTelefono" mnemonicParsing="false" text="Eliminar" />
                            </children>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </HBox>
                        <ListView fx:id="listaTelefonos" prefHeight="150.0" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: gray;" text="Tip: Doble clic en un teléfono para editarlo">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Gestión de Agenda - JavaFX con MySQL" />
            </children>
            <padding>
                <Insets bottom="5.0" top="5.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>