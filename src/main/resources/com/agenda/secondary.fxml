<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.agenda.DireccionesController">
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <ToolBar>
                    <items>
                        <Button fx:id="btnNuevaDireccion" mnemonicParsing="false" text="Nueva Dirección" />
                        <Button fx:id="btnEditarDireccion" mnemonicParsing="false" text="Editar" />
                        <Button fx:id="btnEliminarDireccion" mnemonicParsing="false" text="Eliminar" />
                        <Separator orientation="VERTICAL" />
                        <Button fx:id="btnAsociarPersona" mnemonicParsing="false" text="Asociar a Persona" />
                        <Button fx:id="btnVerCompartidas" mnemonicParsing="false" text="Ver Compartidas" />
                        <Separator orientation="VERTICAL" />
                        <Label text="Buscar:" />
                        <TextField fx:id="txtBuscarDireccion" prefWidth="150.0" promptText="Buscar dirección..." />
                        <Button fx:id="btnBuscarDireccion" mnemonicParsing="false" text="Buscar" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.6" BorderPane.alignment="CENTER">
            <items>
                <VBox>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Lista de Direcciones">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <TableView fx:id="tablaDirecciones" prefHeight="400.0" prefWidth="400.0">
                            <columns>
                                <TableColumn fx:id="columnaCalle" prefWidth="180.0" text="Calle" />
                                <TableColumn fx:id="columnaCiudad" prefWidth="120.0" text="Ciudad" />
                                <TableColumn fx:id="columnaEstado" prefWidth="100.0" text="Estado" />
                                <TableColumn fx:id="columnaPersonas" prefWidth="80.0" text="Personas" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
                <VBox>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Detalles de Dirección">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="10.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                                <RowConstraints minHeight="10.0" vgrow="NEVER" />
                            </rowConstraints>
                            <children>
                                <Label text="Calle:" />
                                <TextField fx:id="txtCalle" prefWidth="200.0" GridPane.columnIndex="1" />
                                <Label text="Ciudad:" GridPane.rowIndex="1" />
                                <TextField fx:id="txtCiudad" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Estado:" GridPane.rowIndex="2" />
                                <TextField fx:id="txtEstado" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label text="Código Postal:" GridPane.rowIndex="3" />
                                <TextField fx:id="txtCodigoPostal" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label text="País:" GridPane.rowIndex="4" />
                                <TextField fx:id="txtPais" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            </children>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnGuardarDireccion" mnemonicParsing="false" text="Guardar" />
                                <Button fx:id="btnCancelarDireccion" mnemonicParsing="false" text="Cancelar" />
                            </children>
                            <VBox.margin>
                                <Insets top="15.0" />
                            </VBox.margin>
                        </HBox>
                        <Separator>
                            <VBox.margin>
                                <Insets bottom="10.0" top="15.0" />
                            </VBox.margin>
                        </Separator>
                        <Label style="-fx-font-weight: bold;" text="Personas que usan esta dirección">
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </Label>
                        <TableView fx:id="tablaPersonasCompartidas" prefHeight="150.0">
                            <columns>
                                <TableColumn fx:id="columnaNombrePersona" prefWidth="120.0" text="Nombre" />
                                <TableColumn fx:id="columnaEtiqueta" prefWidth="80.0" text="Etiqueta" />
                                <TableColumn fx:id="columnaPrincipal" prefWidth="60.0" text="Principal" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnDesasociarPersona" mnemonicParsing="false" text="Desasociar" />
                                <Button fx:id="btnEditarRelacion" mnemonicParsing="false" text="Editar Relación" />
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </items>
        </SplitPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
                <Label text="Gestión de Direcciones - Sistema Compartido" />
                <Button fx:id="btnVolver" mnemonicParsing="false" text="Volver a Personas" />
            </children>
            <padding>
                <Insets bottom="5.0" top="5.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>